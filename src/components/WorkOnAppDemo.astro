---
import type { Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const isRu = lang === 'ru';

const ui = isRu
  ? {
      workspaces: ['Фриланс', 'Основная работа', 'Личное'],
      projectsHeading: 'Проекты',
      allProjects: 'Все проекты',
      projects: [
        { id: 'fintech', name: 'Финтех-портал', color: '#7c3aed', rate: '3 500 ₽/ч' },
        { id: 'mobile', name: 'Мобильный SDK', color: '#10b981', rate: '45 $/ч' },
        { id: 'crm', name: 'Редизайн CRM', color: '#f59e0b', rate: 'Фикс' },
      ],
      modulesLabel: '10 модулей · 100%',
      tabs: [
        { id: 'kanban', label: 'Канбан' },
        { id: 'timeline', label: 'Таймлайн' },
        { id: 'gantt', label: 'Гант' },
        { id: 'finance', label: 'Финансы' },
        { id: 'sprints', label: 'Спринты' },
      ],
      start: 'Старт',
      stop: 'Стоп',
      newTaskBtn: '+ Задача',
      kanbanCols: [
        { id: 'todo', title: 'К выполнению', wip: '' },
        { id: 'progress', title: 'В работе', wip: 'WIP 2/3' },
        { id: 'done', title: 'Готово', wip: 'Финал' },
      ],
      cards: [
        {
          key: 'WRK-47',
          col: 'todo',
          project: 'mobile',
          type: 'Задача',
          typeTone: 'text-sky-400',
          title: 'Экспорт табеля за месяц в CSV',
          meta: 'Подзадачи 0/3 · 2 SP',
          value: '00:00',
        },
        {
          key: 'WRK-42',
          col: 'progress',
          project: 'fintech',
          type: 'Фича',
          typeTone: 'text-accent-soft',
          title: 'Мультивалютный генератор счетов (.xlsx / A4)',
          meta: 'Подзадачи 3/4 · 5 SP',
          value: '04:20',
        },
        {
          key: 'WRK-45',
          col: 'progress',
          project: 'crm',
          type: 'Баг',
          typeTone: 'text-rose-400',
          title: 'Исправить Idle Detection после сна Windows',
          meta: 'Высокий · 3 SP',
          value: '45 000 ₽',
        },
        {
          key: 'WRK-39',
          col: 'done',
          project: 'fintech',
          type: 'Эпик',
          typeTone: 'text-emerald-400',
          title: 'Почасовой таймлайн с раскладкой слотов',
          meta: 'Подзадачи 5/5 · 8 SP',
          value: '11:45',
        },
      ],
      playTaskAria: 'Запустить таймер для задачи',
      timelineHeader: 'Сегодня · Режим «День»',
      timelinePresets: 'Ручной ввод: 1ч · 4ч · 8ч · 24ч · 40ч · 80ч',
      timelineBlocks: [
        { time: '09:30–11:45', key: 'WRK-42', title: 'Генератор счетов и пресеты ИП / НПД', duration: '02:15', kind: 'work' },
        { time: '12:00–12:45', key: 'ПЕРЕРЫВ', title: 'Обед (не включается в биллинг)', duration: '00:45', kind: 'break' },
        { time: '13:00–15:10', key: 'WRK-45', title: 'Тестирование Idle Detection после сна', duration: '02:10', kind: 'work' },
        { time: '15:30–17:00', key: 'WRK-47', title: 'Ревью структуры экспорта CSV', duration: '01:30', kind: 'work' },
      ],
      ganttHeader: 'Диаграмма Ганта · Масштаб: Стандарт',
      ganttHint: 'Перетаскивание сроков · SVG-зависимости',
      ganttTasks: [
        { key: 'WRK-38', title: 'Схема базы JSON и миграции', start: 4, width: 32, progress: 100 },
        { key: 'WRK-42', title: 'Биллинг и счета (.xlsx)', start: 30, width: 42, progress: 72 },
        { key: 'WRK-48', title: 'Печать A4 и Бумажный вид', start: 66, width: 28, progress: 30 },
      ],
      financeHeader: 'Финансы и Счета',
      currencies: 'RUB ₽ · USD $ · EUR € · KZT ₸ · GBP £ · BYN · USDT ₮',
      paperToggleDark: 'Бумажный вид',
      paperToggleLight: 'Тёмный вид',
      invoiceNo: 'Счёт #INV-2026-14',
      invoiceStatus: 'Отправлен',
      invoiceClient: 'Клиент: Финтех-портал (ООО «Вектор»)',
      invoicePreset: 'Пресет: ИП · Невыставленные часы защищены от дубля',
      invoiceLines: [
        { desc: 'WRK-42 · Разработка биллинга (18.5 ч × 3 500 ₽)', amount: '64 750 ₽' },
        { desc: 'WRK-45 · Интеграция CRM (Фикс-цена)', amount: '45 000 ₽' },
      ],
      invoiceTotalLabel: 'Итого к оплате',
      invoiceTotalValue: '109 750 ₽',
      sprintHeader: 'Спринт 14 — Релиз биллинга и отчётов',
      sprintMeta: '10–24 ноя · Выполнено 24 / 32 SP · Цель: стабильный экспорт .xlsx',
      burndownIdeal: 'Идеальная линия',
      burndownActual: 'Фактическое сгорание',
      newTaskToast: 'В десктопной версии открывается карточка создания задачи с ключом, типом и тегами.',
    }
  : {
      workspaces: ['Freelance', 'Day Job', 'Personal'],
      projectsHeading: 'Projects',
      allProjects: 'All projects',
      projects: [
        { id: 'fintech', name: 'Fintech Portal', color: '#7c3aed', rate: '$65/h' },
        { id: 'mobile', name: 'Mobile SDK', color: '#10b981', rate: '$55/h' },
        { id: 'crm', name: 'CRM Redesign', color: '#f59e0b', rate: 'Fixed' },
      ],
      modulesLabel: '10 modules · 100%',
      tabs: [
        { id: 'kanban', label: 'Kanban' },
        { id: 'timeline', label: 'Timeline' },
        { id: 'gantt', label: 'Gantt' },
        { id: 'finance', label: 'Finance' },
        { id: 'sprints', label: 'Sprints' },
      ],
      start: 'Start',
      stop: 'Stop',
      newTaskBtn: '+ Task',
      kanbanCols: [
        { id: 'todo', title: 'To Do', wip: '' },
        { id: 'progress', title: 'In Progress', wip: 'WIP 2/3' },
        { id: 'done', title: 'Done', wip: 'Final' },
      ],
      cards: [
        {
          key: 'WRK-47',
          col: 'todo',
          project: 'mobile',
          type: 'Task',
          typeTone: 'text-sky-400',
          title: 'Monthly timesheet CSV exporter',
          meta: 'Subtasks 0/3 · 2 SP',
          value: '00:00',
        },
        {
          key: 'WRK-42',
          col: 'progress',
          project: 'fintech',
          type: 'Feature',
          typeTone: 'text-accent-soft',
          title: 'Multi-currency invoice builder (.xlsx / A4)',
          meta: 'Subtasks 3/4 · 5 SP',
          value: '04:20',
        },
        {
          key: 'WRK-45',
          col: 'progress',
          project: 'crm',
          type: 'Bug',
          typeTone: 'text-rose-400',
          title: 'Fix Idle Detection resume after sleep',
          meta: 'High · 3 SP',
          value: '$1,200',
        },
        {
          key: 'WRK-39',
          col: 'done',
          project: 'fintech',
          type: 'Epic',
          typeTone: 'text-emerald-400',
          title: 'Hourly Day/Week timeline layout engine',
          meta: 'Subtasks 5/5 · 8 SP',
          value: '11:45',
        },
      ],
      playTaskAria: 'Start timer for task',
      timelineHeader: 'Today · Day View',
      timelinePresets: 'Manual presets: 1h · 4h · 8h · 24h · 40h · 80h',
      timelineBlocks: [
        { time: '09:30–11:45', key: 'WRK-42', title: 'Invoice generator & SWIFT/IBAN presets', duration: '02:15', kind: 'work' },
        { time: '12:00–12:45', key: 'BREAK', title: 'Lunch break (excluded from billable hours)', duration: '00:45', kind: 'break' },
        { time: '13:00–15:10', key: 'WRK-45', title: 'Idle Detection sleep-resume verification', duration: '02:10', kind: 'work' },
        { time: '15:30–17:00', key: 'WRK-47', title: 'Review CSV export columns', duration: '01:30', kind: 'work' },
      ],
      ganttHeader: 'Gantt Chart · Zoom: Standard',
      ganttHint: 'Drag schedule bars · SVG dependencies',
      ganttTasks: [
        { key: 'WRK-38', title: 'Local JSON backup & schema', start: 4, width: 32, progress: 100 },
        { key: 'WRK-42', title: 'Billing & Excel (.xlsx) export', start: 30, width: 42, progress: 72 },
        { key: 'WRK-48', title: 'A4 print & Paper View mode', start: 66, width: 28, progress: 30 },
      ],
      financeHeader: 'Finance & Invoicing',
      currencies: 'RUB ₽ · USD $ · EUR € · KZT ₸ · GBP £ · BYN · USDT ₮',
      paperToggleDark: 'Paper View',
      paperToggleLight: 'Dark View',
      invoiceNo: 'Invoice #INV-2026-14',
      invoiceStatus: 'Sent',
      invoiceClient: 'Client: Fintech Portal (Vector LLC)',
      invoicePreset: 'Preset: International SWIFT/IBAN · Unbilled hours locked',
      invoiceLines: [
        { desc: 'WRK-42 · Billing module engineering (18.5h × $65)', amount: '$1,202.50' },
        { desc: 'WRK-45 · CRM pipeline integration (Fixed)', amount: '$1,200.00' },
      ],
      invoiceTotalLabel: 'Total Due',
      invoiceTotalValue: '$2,402.50',
      sprintHeader: 'Sprint 14 — Billing & Reports Release',
      sprintMeta: 'Nov 10–24 · Completed 24 / 32 SP · Goal: native .xlsx export',
      burndownIdeal: 'Ideal burn',
      burndownActual: 'Actual progress',
      newTaskToast: 'In the desktop app, this opens the full task editor with key, type, tags, and subtasks.',
    };
---

<div
  id="workon-desktop-mockup"
  data-start-label={ui.start}
  data-stop-label={ui.stop}
  data-paper-dark={ui.paperToggleDark}
  data-paper-light={ui.paperToggleLight}
  data-toast={ui.newTaskToast}
  class="w-full overflow-hidden rounded-2xl border border-line-strong bg-canvas-alt shadow-[0_30px_80px_-30px_rgba(0,0,0,0.85)]"
>
  <!-- Frameless Tauri Top Window Bar -->
  <div class="flex h-9 items-center justify-between border-b border-line bg-[#161616] px-4 text-[11px] text-ink-muted select-none">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="font-display font-semibold text-ink">WorkOn</span>
      <span aria-hidden="true">/</span>
      <span id="app-titlebar-ws" class="truncate text-ink-secondary">{ui.workspaces[0]}</span>
    </div>
    <div class="flex items-center gap-3 font-mono text-ink-muted" aria-hidden="true">
      <span>—</span>
      <span>□</span>
      <span>×</span>
    </div>
  </div>

  <!-- App Body: Left Sidebar + Right Main Shell -->
  <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[450px]">
    <!-- Left Sidebar -->
    <aside class="border-b border-line bg-surface p-3.5 lg:col-span-3 lg:border-b-0 lg:border-r flex flex-col justify-between gap-4">
      <div>
        <!-- Workspace Switcher -->
        <div class="flex items-center gap-1 rounded-lg border border-line bg-canvas p-1">
          {ui.workspaces.map((ws, i) => (
            <button
              type="button"
              data-ws-btn={ws}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class={`ws-btn flex-1 min-h-7 rounded-md px-2 py-1 text-[11px] font-medium transition-colors duration-150 truncate cursor-pointer ${
                i === 0
                  ? 'bg-surface-elevated text-ink-strong'
                  : 'text-ink-muted hover:text-ink'
              }`}
            >
              {ws}
            </button>
          ))}
        </div>

        <!-- Projects List -->
        <div class="mt-4">
          <div class="px-2 text-[11px] font-medium text-ink-muted">
            {ui.projectsHeading}
          </div>
          <div class="mt-1.5 space-y-0.5">
            <button
              type="button"
              data-project-filter="all"
              aria-pressed="true"
              class="proj-filter-btn flex w-full min-h-8 items-center justify-between rounded-lg bg-surface-elevated px-2.5 py-1.5 text-left text-xs font-medium text-ink-strong transition-colors duration-150 cursor-pointer"
            >
              <span class="truncate">{ui.allProjects}</span>
              <span class="font-mono text-[11px] text-ink-muted tabular-nums">4</span>
            </button>

            {ui.projects.map((p) => (
              <button
                type="button"
                data-project-filter={p.id}
                aria-pressed="false"
                class="proj-filter-btn flex w-full min-h-8 items-center justify-between gap-2 rounded-lg px-2.5 py-1.5 text-left text-xs text-ink-secondary transition-colors duration-150 hover:bg-surface-elevated hover:text-ink-strong cursor-pointer"
              >
                <span class="flex items-center gap-2 min-w-0">
                  <span
                    class="h-2 w-2 rounded-full shrink-0"
                    style={`background-color: ${p.color}`}
                    aria-hidden="true"
                  ></span>
                  <span class="truncate">{p.name}</span>
                </span>
                <span class="font-mono text-[10px] text-ink-muted tabular-nums shrink-0">
                  {p.rate}
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="hidden lg:flex items-center justify-between border-t border-line pt-3 px-1 font-mono text-[11px] text-ink-muted">
        <span>{ui.modulesLabel}</span>
        <span>SQLite · JSON</span>
      </div>
    </aside>

    <!-- Right Area: App Header + Active Module Content -->
    <div class="lg:col-span-9 flex flex-col bg-canvas-alt">
      <!-- App Internal Header: Module Tabs + Live Timer Widget + Add Task -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line bg-surface px-4 py-2.5">
        <div
          class="flex items-center gap-1 overflow-x-auto"
          role="tablist"
          aria-label="WorkOn modules preview"
        >
          {ui.tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              data-app-tab={tab.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              class={`app-tab-btn min-h-8 rounded-lg px-2.5 py-1 text-xs font-medium transition-colors duration-150 whitespace-nowrap shrink-0 cursor-pointer ${
                i === 0
                  ? 'bg-accent/15 text-accent-soft'
                  : 'text-ink-secondary hover:bg-surface-elevated hover:text-ink-strong'
              }`}
            >
              {tab.label}
            </button>
          ))}
        </div>

        <!-- Live Header Timer Widget -->
        <div class="flex items-center gap-2.5 shrink-0">
          <div class="flex items-center gap-2 rounded-lg border border-line bg-canvas px-2.5 py-1">
            <span
              id="app-timer-dot"
              class="hidden h-2 w-2 rounded-full bg-emerald-500 shrink-0"
              aria-hidden="true"
            ></span>
            <span
              id="app-timer-task"
              class="font-mono text-[11px] font-medium text-accent-soft whitespace-nowrap"
            >
              WRK-42
            </span>
            <span
              id="app-timer-clock"
              class="font-mono text-xs font-semibold text-ink-strong tabular-nums whitespace-nowrap"
            >
              02:14:08
            </span>
            <button
              type="button"
              id="app-timer-toggle"
              class="ml-1 inline-flex min-h-6 items-center rounded bg-accent px-2 py-0.5 text-[11px] font-semibold text-white transition-colors duration-150 hover:bg-accent-hover whitespace-nowrap cursor-pointer"
            >
              {ui.start}
            </button>
          </div>

          <button
            type="button"
            id="app-new-task-btn"
            class="hidden sm:inline-flex min-h-8 items-center rounded-lg border border-line-strong bg-surface-elevated px-2.5 py-1 text-xs font-medium text-ink transition-colors duration-150 hover:bg-surface-hover hover:text-ink-strong whitespace-nowrap cursor-pointer"
          >
            {ui.newTaskBtn}
          </button>
        </div>
      </div>

      <!-- Optional subtle toast line for + Task -->
      <div
        id="app-demo-toast"
        class="hidden border-b border-line bg-surface-elevated px-4 py-2 text-xs text-accent-soft"
      ></div>

      <!-- Module View 1: Kanban Board -->
      <div data-app-panel="kanban" class="p-4 flex-1">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-3">
          {ui.kanbanCols.map((col) => (
            <div class="rounded-xl border border-line bg-surface/70 p-3">
              <div class="mb-3 flex items-center justify-between gap-2 text-xs">
                <span class="font-medium text-ink-strong">{col.title}</span>
                {col.wip && (
                  <span class="font-mono text-[11px] text-ink-muted tabular-nums">
                    {col.wip}
                  </span>
                )}
              </div>

              <div class="space-y-2.5">
                {ui.cards
                  .filter((c) => c.col === col.id)
                  .map((card) => (
                    <div
                      data-kanban-card
                      data-card-project={card.project}
                      class="rounded-xl border border-line bg-surface-elevated p-3 transition-colors duration-150 hover:border-line-strong"
                    >
                      <div class="flex items-center justify-between gap-2 font-mono text-[11px]">
                        <span class="text-ink-muted tabular-nums">{card.key}</span>
                        <span class={card.typeTone}>{card.type}</span>
                      </div>
                      <div class="mt-1.5 text-xs font-medium leading-snug text-ink-strong">
                        {card.title}
                      </div>
                      <div class="mt-2.5 flex items-center justify-between gap-2 border-t border-line pt-2 text-[11px] text-ink-muted">
                        <span class="truncate">{card.meta}</span>
                        <div class="flex items-center gap-1.5 shrink-0">
                          <span class="font-mono text-ink-secondary tabular-nums">
                            {card.value}
                          </span>
                          <button
                            type="button"
                            data-start-card={card.key}
                            aria-label={`${ui.playTaskAria} ${card.key}`}
                            title={`${ui.start} ${card.key}`}
                            class="card-play-btn inline-flex h-6 w-6 items-center justify-center rounded border border-line bg-surface text-ink-secondary transition-colors duration-150 hover:border-accent hover:text-accent-soft cursor-pointer"
                          >
                            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                              <polygon points="7,5 19,12 7,19" />
                            </svg>
                          </button>
                        </div>
                      </div>
                    </div>
                  ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Module View 2: Timeline (Hourly Grid) -->
      <div data-app-panel="timeline" class="hidden p-4 flex-1">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3 text-xs">
          <span class="font-medium text-ink-strong">{ui.timelineHeader}</span>
          <span class="font-mono text-[11px] text-ink-muted">{ui.timelinePresets}</span>
        </div>

        <div class="relative rounded-xl border border-line bg-surface p-3 space-y-2.5">
          {ui.timelineBlocks.map((block, idx) => (
            <div class="flex items-center gap-3">
              <span class="w-24 shrink-0 font-mono text-[11px] text-ink-muted tabular-nums">
                {block.time}
              </span>
              <div
                class={`flex flex-1 items-center justify-between gap-3 rounded-lg border px-3 py-2 text-xs ${
                  block.kind === 'break'
                    ? 'border-amber-500/30 bg-amber-500/10 text-amber-200'
                    : 'border-line-strong bg-surface-elevated text-ink'
                }`}
              >
                <div class="flex items-center gap-2 min-w-0">
                  <span
                    class={`font-mono text-[11px] shrink-0 ${
                      block.kind === 'break' ? 'text-amber-400' : 'text-accent-soft'
                    }`}
                  >
                    {block.key}
                  </span>
                  <span class="truncate">{block.title}</span>
                </div>
                <span class="font-mono text-[11px] text-ink-secondary tabular-nums shrink-0">
                  {block.duration}
                </span>
              </div>
              {idx === 2 && (
                <span class="hidden sm:inline font-mono text-[10px] text-rose-400 shrink-0">
                  ● 14:40
                </span>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Module View 3: Gantt Chart with SVG Dependencies -->
      <div data-app-panel="gantt" class="hidden p-4 flex-1">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3 text-xs">
          <span class="font-medium text-ink-strong">{ui.ganttHeader}</span>
          <span class="font-mono text-[11px] text-ink-muted">{ui.ganttHint}</span>
        </div>

        <div class="rounded-xl border border-line bg-surface p-4">
          <div class="grid grid-cols-12 border-b border-line pb-2 text-[11px] font-mono text-ink-muted">
            <div class="col-span-5">Задача</div>
            <div class="col-span-7 grid grid-cols-4 text-center tabular-nums">
              <span>10 ноя</span>
              <span>14 ноя</span>
              <span>18 ноя</span>
              <span>22 ноя</span>
            </div>
          </div>

          <div class="relative mt-3 space-y-4">
            {ui.ganttTasks.map((task) => (
              <div class="grid grid-cols-12 items-center gap-2 text-xs">
                <div class="col-span-5 flex items-center gap-2 min-w-0">
                  <span class="font-mono text-[11px] text-accent-soft shrink-0 tabular-nums">
                    {task.key}
                  </span>
                  <span class="truncate text-ink">{task.title}</span>
                </div>
                <div class="col-span-7 relative h-7 rounded bg-canvas border border-line/70">
                  <div
                    class="absolute top-1 bottom-1 rounded bg-surface-elevated border border-line-strong overflow-hidden"
                    style={`left: ${task.start}%; width: ${task.width}%;`}
                  >
                    <div
                      class="h-full bg-accent/75"
                      style={`width: ${task.progress}%;`}
                    ></div>
                    <span class="absolute inset-0 flex items-center justify-end pr-1.5 font-mono text-[10px] text-white tabular-nums">
                      {task.progress}%
                    </span>
                  </div>
                </div>
              </div>
            ))}

            <!-- Subtle SVG dependency indicator legend -->
            <div class="pt-2 border-t border-line flex items-center justify-between text-[11px] font-mono text-ink-muted">
              <span>WRK-38 → WRK-42 → WRK-48</span>
              <span>SVG Dependencies</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Module View 4: Finance & Multi-Currency Invoice Preview (with Paper View Toggle) -->
      <div data-app-panel="finance" class="hidden p-4 flex-1">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3 text-xs">
          <div>
            <span class="font-medium text-ink-strong">{ui.financeHeader}</span>
            <span class="ml-2 hidden sm:inline font-mono text-[11px] text-ink-muted">
              {ui.currencies}
            </span>
          </div>
          <button
            type="button"
            id="app-paper-view-btn"
            aria-pressed="false"
            class="inline-flex min-h-7 items-center rounded-md border border-line-strong bg-surface-elevated px-2.5 py-1 text-[11px] font-medium text-ink transition-colors duration-150 hover:border-accent hover:text-accent-soft whitespace-nowrap cursor-pointer"
          >
            {ui.paperToggleDark}
          </button>
        </div>

        <div
          id="app-invoice-card"
          class="rounded-xl border border-line bg-surface p-4 sm:p-5 transition-colors duration-150"
        >
          <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-3">
            <div>
              <div id="inv-title" class="font-mono text-sm font-semibold text-ink-strong tabular-nums">
                {ui.invoiceNo}
              </div>
              <div id="inv-client" class="mt-0.5 text-xs text-ink-secondary">
                {ui.invoiceClient}
              </div>
            </div>
            <span class="font-mono text-xs font-medium text-emerald-500">
              {ui.invoiceStatus}
            </span>
          </div>

          <div id="inv-preset" class="mt-3 text-[11px] text-ink-muted">
            {ui.invoicePreset}
          </div>

          <div class="mt-3 divide-y divide-line border-y border-line">
            {ui.invoiceLines.map((line) => (
              <div class="flex items-center justify-between gap-4 py-2 text-xs">
                <span class="inv-line-desc text-ink">{line.desc}</span>
                <span class="inv-line-amount font-mono font-medium text-ink-strong tabular-nums shrink-0">
                  {line.amount}
                </span>
              </div>
            ))}
          </div>

          <div class="mt-3 flex items-center justify-between text-sm font-semibold">
            <span id="inv-total-label" class="text-ink-secondary">{ui.invoiceTotalLabel}</span>
            <span id="inv-total-value" class="font-mono text-ink-strong tabular-nums">
              {ui.invoiceTotalValue}
            </span>
          </div>
        </div>
      </div>

      <!-- Module View 5: Scrum Sprints & Burndown Chart -->
      <div data-app-panel="sprints" class="hidden p-4 flex-1">
        <div class="mb-3">
          <div class="text-xs font-medium text-ink-strong">{ui.sprintHeader}</div>
          <div class="mt-0.5 font-mono text-[11px] text-ink-muted tabular-nums">
            {ui.sprintMeta}
          </div>
        </div>

        <div class="rounded-xl border border-line bg-surface p-4">
          <svg
            viewBox="0 0 420 135"
            class="w-full h-36"
            role="img"
            aria-label="Sprint Burndown Chart"
          >
            <!-- Grid hairlines -->
            <line x1="28" y1="15" x2="404" y2="15" stroke="#2e2e2e" stroke-width="1" />
            <line x1="28" y1="50" x2="404" y2="50" stroke="#2e2e2e" stroke-width="1" />
            <line x1="28" y1="85" x2="404" y2="85" stroke="#2e2e2e" stroke-width="1" />
            <line x1="28" y1="120" x2="404" y2="120" stroke="#383838" stroke-width="1" />

            <!-- Y axis numbers -->
            <text x="6" y="19" fill="#737373" font-size="10" font-family="JetBrains Mono, monospace">32</text>
            <text x="6" y="54" fill="#737373" font-size="10" font-family="JetBrains Mono, monospace">21</text>
            <text x="6" y="89" fill="#737373" font-size="10" font-family="JetBrains Mono, monospace">10</text>
            <text x="12" y="124" fill="#737373" font-size="10" font-family="JetBrains Mono, monospace">0</text>

            <!-- Ideal burndown line -->
            <line
              x1="28"
              y1="15"
              x2="404"
              y2="120"
              stroke="#737373"
              stroke-width="1.5"
              stroke-dasharray="5 5"
            />

            <!-- Actual burndown curve -->
            <polyline
              fill="none"
              stroke="#7c3aed"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              points="28,15 80,22 135,38 190,46 245,68 300,82 352,92"
            />
            <circle cx="352" cy="92" r="4" fill="#10b981" />
          </svg>

          <div class="mt-2 flex flex-wrap items-center gap-5 text-[11px] text-ink-muted">
            <span class="inline-flex items-center gap-2">
              <span class="h-0.5 w-4 border-t border-dashed border-ink-muted"></span>
              {ui.burndownIdeal}
            </span>
            <span class="inline-flex items-center gap-2">
              <span class="h-0.5 w-4 bg-accent"></span>
              {ui.burndownActual}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const mockup = document.getElementById('workon-desktop-mockup');
  if (mockup) {
    const startLabel = mockup.getAttribute('data-start-label') || 'Start';
    const stopLabel = mockup.getAttribute('data-stop-label') || 'Stop';
    const paperDarkLabel = mockup.getAttribute('data-paper-dark') || 'Paper View';
    const paperLightLabel = mockup.getAttribute('data-paper-light') || 'Dark View';
    const toastMsg = mockup.getAttribute('data-toast') || '';

    // 1. Workspace Switcher
    const titleWs = document.getElementById('app-titlebar-ws');
    const wsBtns = Array.from(mockup.querySelectorAll<HTMLButtonElement>('.ws-btn'));
    wsBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const ws = btn.getAttribute('data-ws-btn') || '';
        if (titleWs) titleWs.textContent = ws;
        wsBtns.forEach((item) => {
          const active = item === btn;
          item.setAttribute('aria-pressed', String(active));
          item.classList.toggle('bg-surface-elevated', active);
          item.classList.toggle('text-ink-strong', active);
          item.classList.toggle('text-ink-muted', !active);
        });
      });
    });

    // 2. Project Filter on Kanban
    const projBtns = Array.from(mockup.querySelectorAll<HTMLButtonElement>('.proj-filter-btn'));
    const kanbanCards = Array.from(mockup.querySelectorAll<HTMLElement>('[data-kanban-card]'));
    projBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-project-filter') || 'all';
        projBtns.forEach((item) => {
          const active = item === btn;
          item.setAttribute('aria-pressed', String(active));
          item.classList.toggle('bg-surface-elevated', active);
          item.classList.toggle('text-ink-strong', active);
          item.classList.toggle('font-medium', active);
          item.classList.toggle('text-ink-secondary', !active);
        });
        kanbanCards.forEach((card) => {
          const match = filter === 'all' || card.getAttribute('data-card-project') === filter;
          card.classList.toggle('hidden', !match);
        });
      });
    });

    // 3. Module Tabs inside desktop shell
    const appTabs = Array.from(mockup.querySelectorAll<HTMLButtonElement>('.app-tab-btn'));
    const appPanels = Array.from(mockup.querySelectorAll<HTMLElement>('[data-app-panel]'));
    appTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-app-tab');
        appTabs.forEach((item) => {
          const active = item === tab;
          item.setAttribute('aria-selected', String(active));
          item.classList.toggle('bg-accent/15', active);
          item.classList.toggle('text-accent-soft', active);
          item.classList.toggle('text-ink-secondary', !active);
        });
        appPanels.forEach((panel) => {
          panel.classList.toggle('hidden', panel.getAttribute('data-app-panel') !== id);
        });
      });
    });

    // 4. Live Header Timer + Card Quick-Launch
    const timerClock = document.getElementById('app-timer-clock');
    const timerTask = document.getElementById('app-timer-task');
    const timerDot = document.getElementById('app-timer-dot');
    const timerBtn = document.getElementById('app-timer-toggle');

    let running = false;
    let totalSeconds = 2 * 3600 + 14 * 60 + 8;
    let intervalId: number | null = null;

    function fmt(sec: number): string {
      const h = Math.floor(sec / 3600);
      const m = Math.floor((sec % 3600) / 60);
      const s = sec % 60;
      return [h, m, s].map((n) => String(n).padStart(2, '0')).join(':');
    }

    function syncTimerUI() {
      if (timerClock) timerClock.textContent = fmt(totalSeconds);
      if (timerDot) timerDot.classList.toggle('hidden', !running);
      if (timerBtn) {
        timerBtn.textContent = running ? stopLabel : startLabel;
        timerBtn.classList.toggle('bg-rose-600', running);
        timerBtn.classList.toggle('hover:bg-rose-500', running);
        timerBtn.classList.toggle('bg-accent', !running);
        timerBtn.classList.toggle('hover:bg-accent-hover', !running);
      }
    }

    function startRunning() {
      if (running) return;
      running = true;
      intervalId = window.setInterval(() => {
        totalSeconds += 1;
        if (timerClock) timerClock.textContent = fmt(totalSeconds);
      }, 1000);
      syncTimerUI();
    }

    function stopRunning() {
      if (!running) return;
      running = false;
      if (intervalId !== null) {
        window.clearInterval(intervalId);
        intervalId = null;
      }
      syncTimerUI();
    }

    timerBtn?.addEventListener('click', () => {
      if (running) stopRunning();
      else startRunning();
    });

    mockup.querySelectorAll<HTMLButtonElement>('.card-play-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-start-card');
        if (key && timerTask) {
          timerTask.textContent = key;
        }
        startRunning();
      });
    });

    // 5. Invoice Paper View Toggle
    const paperBtn = document.getElementById('app-paper-view-btn');
    const invoiceCard = document.getElementById('app-invoice-card');
    let paperMode = false;

    paperBtn?.addEventListener('click', () => {
      paperMode = !paperMode;
      paperBtn.setAttribute('aria-pressed', String(paperMode));
      paperBtn.textContent = paperMode ? paperLightLabel : paperDarkLabel;

      if (invoiceCard) {
        invoiceCard.classList.toggle('bg-white', paperMode);
        invoiceCard.classList.toggle('text-slate-900', paperMode);
        invoiceCard.classList.toggle('border-slate-200', paperMode);
        invoiceCard.classList.toggle('bg-surface', !paperMode);
        invoiceCard.classList.toggle('border-line', !paperMode);

        invoiceCard.querySelectorAll('#inv-title, #inv-total-value, .inv-line-amount').forEach((el) => {
          el.classList.toggle('text-slate-900', paperMode);
          el.classList.toggle('text-ink-strong', !paperMode);
        });
        invoiceCard.querySelectorAll('#inv-client, #inv-total-label, .inv-line-desc').forEach((el) => {
          el.classList.toggle('text-slate-700', paperMode);
          el.classList.toggle('text-ink-secondary', !paperMode);
          el.classList.toggle('text-ink', !paperMode);
        });
        invoiceCard.querySelectorAll('#inv-preset').forEach((el) => {
          el.classList.toggle('text-slate-500', paperMode);
          el.classList.toggle('text-ink-muted', !paperMode);
        });
      }
    });

    // 6. + Task quick feedback banner
    const newTaskBtn = document.getElementById('app-new-task-btn');
    const toastEl = document.getElementById('app-demo-toast');
    let toastTimer: number | null = null;
    newTaskBtn?.addEventListener('click', () => {
      if (!toastEl) return;
      toastEl.textContent = toastMsg;
      toastEl.classList.remove('hidden');
      if (toastTimer !== null) window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toastEl.classList.add('hidden');
      }, 3500);
    });
  }
</script>
