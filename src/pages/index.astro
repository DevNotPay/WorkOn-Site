---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Текущая версия приложения и ссылки на файлы
const currentVersion = "1.0.0";
const releaseDate = "Ноябрь 2026";

// Ссылки на релизы в вашем репозитории программы DevNotPay
const downloadLinks = {
  windows: "https://github.com/DevNotPay/FreeWorkTracker/releases/latest/download/WorkOn-Setup.exe",
  windowsPortable: "https://github.com/DevNotPay/FreeWorkTracker/releases/latest/download/WorkOn-Portable.zip",
  macos: "https://github.com/DevNotPay/FreeWorkTracker/releases/latest/download/WorkOn.dmg",
  linux: "https://github.com/DevNotPay/FreeWorkTracker/releases/latest/download/WorkOn.AppImage",
};
---

<Layout title="WorkOn — Бесплатный трекер рабочего времени">
  <!-- Hero Секция -->
  <section class="text-center pt-8 pb-16 sm:pt-16 sm:pb-24">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs sm:text-sm font-medium mb-6">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      Свежий релиз WorkOn v{currentVersion} доступен для загрузки
    </div>

    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white max-w-3xl mx-auto leading-tight sm:leading-none">
      Отслеживайте время. <br />
      <span class="bg-gradient-to-r from-indigo-400 via-sky-400 to-emerald-400 bg-clip-text text-transparent">
        Без подписок и рекламы.
      </span>
    </h1>

    <p class="mt-6 text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto">
      Легкий и удобный десктопный тайм-трекер для фрилансеров и разработчиков. 
      Один клик — и работа началась. Все данные хранятся строго на вашем компьютере.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <span class="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-medium">
        💾 Сельфхостед — данные только у вас
      </span>
      <span class="px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-xs font-medium">
        🚫 Нет пейволов, подписок и рекламы
      </span>
      <span class="px-3 py-1 rounded-full bg-slate-700/50 text-slate-400 border border-slate-700 text-xs font-medium">
        📜 Лицензия AGPLv3
      </span>
    </div>

    <!-- Кнопки действий -->
    <div class="mt-10 flex flex-wrap justify-center items-center gap-4">
      <a
        href="#download"
        class="px-8 py-3.5 text-base font-semibold rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white transition shadow-lg shadow-indigo-600/30 hover:scale-[1.02] active:scale-[0.98]"
      >
        Скачать WorkOn бесплатно
      </a>
      <a
        href={`${base}/changelog`}
        class="px-6 py-3.5 text-base font-semibold rounded-xl bg-slate-900 hover:bg-slate-850 text-slate-300 hover:text-white border border-slate-800 transition"
      >
        Что нового в v{currentVersion}
      </a>
    </div>

    <div class="mt-4 text-xs text-slate-500">
      Версия {currentVersion} ({releaseDate}) • Полностью бесплатно
    </div>
  </section>

  <!-- Скачивание (якорь из шапки и главной кнопки) -->
  <section id="download" class="py-12 border-t border-slate-900">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800/80">
        <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center text-xl mb-4 border border-indigo-500/20">
          🔒
        </div>
        <h3 class="text-lg font-bold text-white mb-2">100% Приватно</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Никаких обязательных аккаунтов, облачных синхронизаций и трекеров активности. Ваши проекты и клиенты остаются только у вас.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800/80">
        <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center text-xl mb-4 border border-sky-500/20">
          ⚡
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Быстрый и тихий</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Потребляет минимум ресурсов, мгновенно сворачивается в трей и управляется горячими клавишами без лишних окон.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800/80">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl mb-4 border border-emerald-500/20">
          🎁
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Честно бесплатно</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Никаких платных тарифов, лимитов на количество задач или водяных знаков в отчетах. Проект развивается для людей.
        </p>
      </div>
    </div>
  </section>

  <!-- Блок скачивания (Download) -->
  <section id="download" class="py-16 border-t border-slate-900 scroll-mt-20">
    <div class="text-center max-w-xl mx-auto mb-10">
      <h2 class="text-3xl font-extrabold text-white">Скачать WorkOn</h2>
      <p class="mt-3 text-slate-400 text-sm">
        Установите WorkOn на свой рабочий компьютер и начните отслеживать задачи в один клик.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <!-- Windows -->
      <div class="p-6 rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-2xl">🪟</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-medium">Популярное</span>
          </div>
          <h3 class="text-xl font-bold text-white">Windows</h3>
          <p class="text-xs text-slate-400 mt-1 mb-6">Windows 10, 11 (64-bit)</p>
        </div>
        <div class="space-y-2">
          <a
            href={downloadLinks.windows}
            class="block w-full py-2.5 text-center text-sm font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white transition"
          >
            Установщик (.exe)
          </a>
          <a
            href={downloadLinks.windowsPortable}
            class="block w-full py-2 text-center text-xs font-medium rounded-lg text-slate-400 hover:text-white hover:bg-slate-850 transition"
          >
            Portable (.zip)
          </a>
        </div>
      </div>

      <!-- macOS -->
      <div class="p-6 rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-2xl">🍎</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 font-medium">Apple</span>
          </div>
          <h3 class="text-xl font-bold text-white">macOS</h3>
          <p class="text-xs text-slate-400 mt-1 mb-6">macOS 12+ (Apple Silicon & Intel)</p>
        </div>
        <div>
          <a
            href={downloadLinks.macos}
            class="block w-full py-2.5 text-center text-sm font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-white transition"
          >
            Скачать (.dmg)
          </a>
        </div>
      </div>

      <!-- Linux -->
      <div class="p-6 rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 flex flex-col justify-between hover:border-slate-700 transition">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-2xl">🐧</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 font-medium">Open Source</span>
          </div>
          <h3 class="text-xl font-bold text-white">Linux</h3>
          <p class="text-xs text-slate-400 mt-1 mb-6">Ubuntu, Fedora, Arch и др.</p>
        </div>
        <div>
          <a
            href={downloadLinks.linux}
            class="block w-full py-2.5 text-center text-sm font-semibold rounded-lg bg-slate-800 hover:bg-slate-700 text-white transition"
          >
            Скачать (.AppImage)
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Скриншоты приложения (заглушки) -->
  <section class="py-12 border-t border-slate-900">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Интерфейс WorkOn</h2>
      <p class="text-sm text-slate-400 max-w-xl mx-auto">
        Скриншоты применятся здесь, как только будут готовы. Пока — примерная структура окна приложения.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800">
        <div class="flex items-center justify-between mb-4">
          <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white">⏱</div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono text-slate-400">00:00:00</span>
            <button class="px-3 py-1 rounded bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-500">Старт</button>
          </div>
        </div>
        <div class="h-32 bg-slate-950/50 rounded-xl border border-slate-800 flex items-center justify-center text-slate-500 text-sm">
          Таймер и активная задача
        </div>
      </div>
      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800">
        <div class="h-8 bg-slate-950/50 rounded border border-slate-800 mb-4"></div>
        <div class="space-y-3">
          <div class="flex justify-between text-sm text-slate-300">
            <span>Проект: Сайт WorkOn</span><span class="text-slate-500">2h 15m</span>
          </div>
          <div class="flex justify-between text-sm text-slate-300">
            <span>Клиент: Фриланс</span><span class="text-slate-500">1h 40m</span>
          </div>
          <div class="flex justify-between text-sm text-slate-300">
            <span>Документация</span><span class="text-slate-500">45m</span>
          </div>
        </div>
        <div class="h-20 bg-slate-950/50 rounded-xl border border-slate-800 mt-4 flex items-center justify-center text-slate-500 text-sm">
          Список задач и времени
        </div>
      </div>
      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800">
        <div class="h-8 bg-slate-950/50 rounded border border-slate-800 mb-4"></div>
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-slate-950/50 rounded border border-slate-800 p-3">
            <div class="text-[10px] text-slate-500 mb-1">Всего записано</div>
            <div class="text-xl font-bold text-white">42h 30m</div>
          </div>
          <div class="bg-slate-950/50 rounded border border-slate-800 p-3">
            <div class="text-[10px] text-slate-500 mb-1">За сегодня</div>
            <div class="text-xl font-bold text-white">7h 15m</div>
          </div>
        </div>
        <div class="h-24 bg-slate-950/50 rounded-xl border border-slate-800 mt-4 flex items-center justify-center text-slate-500 text-sm">
          Отчёты и статистика
        </div>
      </div>
    </div>
  </section>

  <!-- Призыв поддержать проект (Donate CTA) -->
  <section class="my-12 p-8 rounded-3xl bg-gradient-to-r from-indigo-950/40 via-purple-950/20 to-slate-900 border border-indigo-900/40 flex flex-col sm:flex-row items-center justify-between gap-6">
    <div>
      <h3 class="text-xl font-bold text-white">Нравится WorkOn?</h3>
      <p class="text-sm text-slate-400 mt-1 max-w-lg">
        WorkOn развивается на чистом энтузиазме. Если тайм-трекер помогает вам в работе, вы можете поддержать автора чашкой кофе.
      </p>
    </div>
    <a
      href={`${base}/donate`}
      class="whitespace-nowrap px-6 py-3 rounded-xl bg-white hover:bg-slate-200 text-slate-950 font-semibold text-sm transition shadow-lg shadow-white/10"
    >
      Поддержать проект ☕
    </a>
  </section>
</Layout>
