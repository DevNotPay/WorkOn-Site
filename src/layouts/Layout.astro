---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "WorkOn — Бесплатный трекер рабочего времени",
  description = "Простой, легкий и полностью бесплатный тайм-трекер для Windows, macOS и Linux. Без подписок, рекламы и слежки."
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { href: `${base}/`, label: "Главная" },
  { href: `${base}/changelog`, label: "Блог / Чейнджлог" },
  { href: `${base}/roadmap`, label: "Дорожная карта" },
  { href: `${base}/donate`, label: "Поддержать проект" },
  { href: `${base}/contacts`, label: "Контакты" },
  { href: "https://github.com/DevNotPay/FreeWorkTracker", label: "GitHub", external: true },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="ru" class="h-full bg-slate-950 text-slate-100 antialiased selection:bg-indigo-500 selection:text-white">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${base}/og-image.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${base}/og-image.jpg`} />
  </head>
  <body class="min-h-full flex flex-col font-sans bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.15),rgba(255,255,255,0))]">
    <!-- Шапка (Header) -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/80">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <!-- Логотип -->
        <a href={`${base}/`} class="flex items-center gap-2.5 font-bold text-lg text-white hover:opacity-90 transition">
          <span class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white shadow-lg shadow-indigo-500/25">
            ⏱
          </span>
          <span>Work<span class="text-indigo-400">On</span> <span class="text-xs px-2 py-0.5 ml-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 font-medium">Free</span></span>
        </a>

        <!-- Навигация -->
        <nav class="flex items-center gap-1 sm:gap-2 text-sm font-medium">
          {navItems.map((item) => {
            const normalizedHref = item.href.replace(/\/$/, '') || '/';
            const isActive = currentPath === normalizedHref;
            return (
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                class={`px-3 py-1.5 rounded-lg transition-colors ${
                  isActive
                    ? "bg-slate-800 text-white"
                    : "text-slate-400 hover:text-white hover:bg-slate-900"
                }`}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <!-- Кнопка Скачать в шапке -->
        <div class="hidden sm:block">
          <a
            href={`${base}/#download`}
            class="px-4 py-2 text-sm font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white transition shadow-sm hover:shadow-indigo-500/20"
          >
            Скачать
          </a>
        </div>
      </div>
    </header>

    <!-- Основной контент -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-10">
      <slot />
    </main>

    <!-- Подвал (Footer) -->
    <footer class="border-t border-slate-900 bg-slate-950/50 py-8 text-center text-xs text-slate-500">
      <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          © {new Date().getFullYear()} WorkOn. Бесплатный инструмент с открытой душой.
        </div>
        <div class="flex items-center gap-6">
          <a href={`${base}/changelog`} class="hover:text-slate-300 transition">История версий</a>
          <a href={`${base}/donate`} class="hover:text-slate-300 transition">Поддержать</a>
          <a href="https://github.com/DevNotPay/FreeWorkTracker" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition">GitHub</a>
        </div>
        <div class="mt-4 sm:mt-0 text-[10px] text-slate-500">Лицензия: AGPLv3 • Открытый исходный код</div>
      </div>
    </footer>
  </body>
</html>
