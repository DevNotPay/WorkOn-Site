---
import '../styles/global.css';
import { LATEST_RELEASE, SITE_CONFIG } from '../data/siteConfig';
import {
  TRANSLATIONS,
  getAlternateLang,
  getLocalePath,
  type Lang,
} from '../i18n/translations';

interface Props {
  lang?: Lang;
  pageKey?: 'home' | 'changelog' | 'donate' | 'notFound';
  title?: string;
  description?: string;
  routePath?: string;
  noindex?: boolean;
}

const {
  lang = 'ru',
  pageKey = 'home',
  title,
  description,
  routePath = '/',
  noindex = false,
} = Astro.props;

const t = TRANSLATIONS[lang];
const altLang = getAlternateLang(lang);

const pageTitle =
  title ??
  (pageKey === 'changelog'
    ? t.seo.changelogTitle
    : pageKey === 'donate'
      ? t.seo.donateTitle
      : pageKey === 'notFound'
        ? t.seo.notFoundTitle
        : t.seo.homeTitle);

const pageDescription =
  description ??
  (pageKey === 'changelog'
    ? t.seo.changelogDesc
    : pageKey === 'donate'
      ? t.seo.donateDesc
      : t.seo.homeDesc);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p: string) => `${base}${p}`;

const currentLocalePath = getLocalePath(lang, routePath);
const ruUrl = new URL(getLocalePath('ru', routePath), SITE_CONFIG.siteUrl).toString();
const enUrl = new URL(getLocalePath('en', routePath), SITE_CONFIG.siteUrl).toString();
const canonicalUrl = new URL(currentLocalePath, SITE_CONFIG.siteUrl).toString();
const switchHref = withBase(getLocalePath(altLang, routePath));

const homeHref = withBase(getLocalePath(lang, '/'));
const changelogHref = withBase(getLocalePath(lang, '/changelog'));
const donateHref = withBase(getLocalePath(lang, '/donate'));
const downloadAnchorHref = `${homeHref}#download`;

const normalizedCurrent = Astro.url.pathname.replace(/\/$/, '') || '/';
const isRouteActive = (href: string) => {
  const norm = href.replace(/\/$/, '') || '/';
  return normalizedCurrent === norm;
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE_CONFIG.name,
  applicationCategory: 'ProductivityApplication',
  operatingSystem: 'Windows 10, Windows 11, macOS 12+, Linux',
  softwareVersion: LATEST_RELEASE.version,
  datePublished: LATEST_RELEASE.isoDate,
  description: pageDescription,
  url: canonicalUrl,
  downloadUrl: LATEST_RELEASE.downloads?.windows ?? SITE_CONFIG.githubReleasesUrl,
  inLanguage: lang,
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<!doctype html>
<html lang={lang} class="h-full bg-canvas text-ink">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0A0B0D" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {!noindex && (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="ru" href={ruUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={ruUrl} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ru' ? 'en_US' : 'ru_RU'} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    )}
  </head>

  <body class="min-h-full flex flex-col bg-canvas text-ink selection:bg-accent selection:text-accent-ink">
    <header class="sticky top-0 z-50 border-b border-line bg-canvas/90 backdrop-blur-md">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-8 px-4 sm:px-6 lg:px-8">
        <!-- Zone 1: Brand Wordmark -->
        <a
          href={homeHref}
          class="inline-flex items-center gap-2.5 font-display text-base font-bold tracking-tight text-ink transition-opacity duration-150 hover:opacity-85 whitespace-nowrap shrink-0"
        >
          <svg
            class="h-5 w-5 shrink-0"
            viewBox="0 0 64 64"
            fill="none"
            aria-hidden="true"
          >
            <rect width="64" height="64" rx="14" fill="#171A20" />
            <rect x="2" y="2" width="60" height="60" rx="12" stroke="#323746" stroke-width="4" />
            <circle cx="32" cy="34" r="17" stroke="#525866" stroke-width="4" />
            <path d="M32 17A17 17 0 0 1 48 28.2" stroke="#F59E0B" stroke-width="4" stroke-linecap="round" />
            <line x1="32" y1="34" x2="41" y2="27" stroke="#F4F4F5" stroke-width="4" stroke-linecap="round" />
            <circle cx="32" cy="34" r="3" fill="#F59E0B" />
          </svg>
          <span>WorkOn</span>
        </a>

        <!-- Zone 2: Clean Single-Line Nav Links -->
        <nav
          aria-label="Primary navigation"
          class="hidden md:flex items-center gap-7 text-sm font-medium"
        >
          <a
            href={homeHref}
            aria-current={isRouteActive(homeHref) ? 'page' : undefined}
            class={`py-1 transition-colors duration-150 whitespace-nowrap shrink-0 border-b ${
              isRouteActive(homeHref)
                ? 'border-accent text-ink'
                : 'border-transparent text-ink-secondary hover:text-ink hover:border-line-strong'
            }`}
          >
            {t.nav.home}
          </a>
          <a
            href={changelogHref}
            aria-current={isRouteActive(changelogHref) ? 'page' : undefined}
            class={`py-1 transition-colors duration-150 whitespace-nowrap shrink-0 border-b ${
              isRouteActive(changelogHref)
                ? 'border-accent text-ink'
                : 'border-transparent text-ink-secondary hover:text-ink hover:border-line-strong'
            }`}
          >
            {t.nav.changelog}
          </a>
          <a
            href={donateHref}
            aria-current={isRouteActive(donateHref) ? 'page' : undefined}
            class={`py-1 transition-colors duration-150 whitespace-nowrap shrink-0 border-b ${
              isRouteActive(donateHref)
                ? 'border-accent text-ink'
                : 'border-transparent text-ink-secondary hover:text-ink hover:border-line-strong'
            }`}
          >
            {t.nav.donate}
          </a>
          <a
            href={switchHref}
            aria-label={t.switchLangAria}
            class="py-1 font-mono text-xs text-ink-muted transition-colors duration-150 hover:text-ink whitespace-nowrap shrink-0 border-b border-transparent hover:border-line-strong"
          >
            {t.switchLangLabel}
          </a>
        </nav>

        <!-- Zone 3: Single Primary Action (Desktop) / Menu Toggle (Mobile) -->
        <div class="flex items-center shrink-0">
          <a
            href={downloadAnchorHref}
            class="hidden md:inline-flex min-h-9 items-center justify-center rounded-md bg-accent px-4 py-2 text-xs font-semibold text-accent-ink transition-colors duration-150 hover:bg-accent-hover whitespace-nowrap shrink-0"
          >
            {t.nav.downloadCta}
          </a>

          <button
            type="button"
            id="mobile-menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
            aria-label={t.nav.openMenu}
            data-label-open={t.nav.openMenu}
            data-label-close={t.nav.closeMenu}
            class="inline-flex md:hidden h-10 w-10 items-center justify-center rounded-md border border-line bg-surface text-ink-secondary transition-colors duration-150 hover:text-ink hover:border-line-strong"
          >
            <svg
              id="icon-menu-open"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="4" y1="7" x2="20" y2="7" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="17" x2="20" y2="17" />
            </svg>
            <svg
              id="icon-menu-close"
              class="hidden h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <nav
        id="mobile-nav-drawer"
        aria-label="Mobile navigation"
        class="hidden md:hidden border-t border-line bg-surface px-4 py-4"
      >
        <div class="flex flex-col gap-1">
          <a
            href={homeHref}
            class={`flex min-h-11 items-center rounded-md px-3 text-sm font-medium transition-colors duration-150 ${
              isRouteActive(homeHref)
                ? 'bg-surface-elevated text-ink'
                : 'text-ink-secondary hover:bg-surface-elevated hover:text-ink'
            }`}
          >
            {t.nav.home}
          </a>
          <a
            href={changelogHref}
            class={`flex min-h-11 items-center rounded-md px-3 text-sm font-medium transition-colors duration-150 ${
              isRouteActive(changelogHref)
                ? 'bg-surface-elevated text-ink'
                : 'text-ink-secondary hover:bg-surface-elevated hover:text-ink'
            }`}
          >
            {t.nav.changelog}
          </a>
          <a
            href={donateHref}
            class={`flex min-h-11 items-center rounded-md px-3 text-sm font-medium transition-colors duration-150 ${
              isRouteActive(donateHref)
                ? 'bg-surface-elevated text-ink'
                : 'text-ink-secondary hover:bg-surface-elevated hover:text-ink'
            }`}
          >
            {t.nav.donate}
          </a>
          <a
            href={switchHref}
            class="flex min-h-11 items-center justify-between rounded-md px-3 text-sm font-medium text-ink-secondary transition-colors duration-150 hover:bg-surface-elevated hover:text-ink"
          >
            <span>{t.switchLangAria}</span>
            <span class="font-mono text-xs text-ink-muted">{t.switchLangLabel}</span>
          </a>
          <div class="mt-3 pt-3 border-t border-line">
            <a
              href={downloadAnchorHref}
              class="flex min-h-11 w-full items-center justify-center rounded-md bg-accent px-4 py-2.5 text-sm font-semibold text-accent-ink transition-colors duration-150 hover:bg-accent-hover"
            >
              {t.nav.downloadCta}
            </a>
          </div>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line bg-canvas py-10 text-xs text-ink-muted">
      <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 sm:flex-row sm:items-center sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <span>© {new Date().getFullYear()} {t.footer.copyright}</span>
          <span aria-hidden="true">·</span>
          <span class="font-mono tabular-nums">v{LATEST_RELEASE.version}</span>
        </div>

        <div class="flex flex-wrap items-center gap-6">
          <a href={changelogHref} class="transition-colors duration-150 hover:text-ink whitespace-nowrap">
            {t.footer.changelog}
          </a>
          <a href={donateHref} class="transition-colors duration-150 hover:text-ink whitespace-nowrap">
            {t.footer.donate}
          </a>
          <a
            href={SITE_CONFIG.githubRepo}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors duration-150 hover:text-ink whitespace-nowrap"
          >
            {t.footer.github}
          </a>
          <a
            href={switchHref}
            aria-label={t.switchLangAria}
            class="font-mono transition-colors duration-150 hover:text-ink whitespace-nowrap"
          >
            {t.switchLangLabel}
          </a>
        </div>
      </div>
    </footer>

    <script>
      const toggleBtn = document.getElementById('mobile-menu-toggle');
      const drawer = document.getElementById('mobile-nav-drawer');
      const openIcon = document.getElementById('icon-menu-open');
      const closeIcon = document.getElementById('icon-menu-close');

      function setMenuOpen(open: boolean) {
        if (!toggleBtn || !drawer || !openIcon || !closeIcon) return;
        toggleBtn.setAttribute('aria-expanded', String(open));
        toggleBtn.setAttribute(
          'aria-label',
          open
            ? toggleBtn.getAttribute('data-label-close') || 'Close menu'
            : toggleBtn.getAttribute('data-label-open') || 'Open menu'
        );
        drawer.classList.toggle('hidden', !open);
        openIcon.classList.toggle('hidden', open);
        closeIcon.classList.toggle('hidden', !open);
      }

      toggleBtn?.addEventListener('click', () => {
        const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!isOpen);
      });

      drawer?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuOpen(false));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggleBtn?.getAttribute('aria-expanded') === 'true') {
          setMenuOpen(false);
          toggleBtn.focus();
        }
      });
    </script>
  </body>
</html>
